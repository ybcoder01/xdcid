APOTHEM_RPC_URL=https://erpc.apothem.network

# Server-side flag for the temporary, wallet-restricted Apothem deployment page.
# Set only in a Vercel Preview deployment and remove immediately after activation.
ENABLE_APOTHEM_DEPLOYMENT=false

# Preview-only acceptance test for the deployed Apothem pricing stack.
# Remove after testing; never enable in Production.
ENABLE_APOTHEM_PRICING_TEST=false
NEXT_PUBLIC_APOTHEM_RPC_URL=https://rpc.apothem.network
XDC_MAINNET_RPC_URL=https://earpc.xinfin.network
NEXT_PUBLIC_XDC_RPC_URL=https://rpc.xdcrpc.com

# Public WalletConnect Cloud application identifier. Configure the real value in Vercel.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional, non-secret route allowlist for controlled Vercel Preview validation.
# Do not set this in Production until each route is validated. Format: source:destination.
# XDC -> Base example: 50:8453
NEXT_PUBLIC_XDCID_PREVIEW_FORWARDING_ROUTES=

# Server-only API settings. Never put private provider URLs in NEXT_PUBLIC_* variables.
XDC_RPC_URLS=https://rpc.xdcrpc.com,https://earpc.xinfin.network
XDC_RPC_TIMEOUT_MS=3500

# Optional server-side RPC fallbacks for verifying multichain forwarding recovery.
# Comma-separate multiple providers. Do not commit private provider URLs.
ETHEREUM_RPC_URLS=
BASE_RPC_URLS=
POLYGON_RPC_URLS=
ARBITRUM_RPC_URLS=
PAYMENT_RPC_TIMEOUT_MS=3500
XDC_API_CACHE_TTL_MS=15000

# Server-only key injected by the XDC AI Gateway. Never use NEXT_PUBLIC_*.
XDCID_GATEWAY_API_KEY=

# Server-only XDCScan settings used to discover historical registrations.
# Keep the API key in Vercel environment variables, never in source control.
XDCSCAN_API_KEY=
XDCSCAN_API_URL=https://api.etherscan.io/v2/api
XDCID_REGISTRAR_HISTORY=

# Server-only CoinGecko Demo API key for informational XDC pricing quotes.
# Add the real value in Vercel and never expose it through NEXT_PUBLIC_*.
COINGECKO_DEMO_API_KEY=
COINGECKO_PRICE_CACHE_MS=60000
COINGECKO_TIMEOUT_MS=3500

# Server-only signed registrar quote settings. Never use NEXT_PUBLIC_* for these.
# The signer must match the active signer in XNSPricingPolicy.
XNS_SIGNED_QUOTE_REGISTRAR=
XNS_PRICING_POLICY=
XNS_QUOTE_CHAIN_ID=50
XNS_QUOTE_RPC_URLS=
XNS_QUOTE_RPC_TIMEOUT_MS=3500
XNS_QUOTE_SIGNER_PRIVATE_KEY=

PRIVATE_KEY=0x...
NEXT_PUBLIC_XNS_REGISTRY=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_XNS_REGISTRAR=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_XNS_RESOLVER=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_XNS_REVERSE_RESOLVER=0x0000000000000000000000000000000000000000

# Server-only Neon PostgreSQL connection injected by the Vercel integration.
# It contains credentials and must never use a NEXT_PUBLIC_* variable.
DATABASE_URL=
