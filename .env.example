APOTHEM_RPC_URL=https://erpc.apothem.network
XDC_MAINNET_RPC_URL=https://earpc.xinfin.network
NEXT_PUBLIC_XDC_RPC_URL=https://rpc.xdcrpc.com

# Temporary server-only gate for the wallet-signed mainnet deployment page.
# Set to true in Vercel Preview only and remove immediately after deployment.
ENABLE_MAINNET_PRICING_DEPLOYMENT=false

# Public WalletConnect Cloud application identifier. Configure the real value in Vercel.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional, non-secret route allowlist for controlled Vercel Preview validation.
# Do not set this in Production until each route is validated. Format: source:destination.
# XDC -> Base example: 50:8453
NEXT_PUBLIC_XDCID_PREVIEW_FORWARDING_ROUTES=

# Server-only API settings. Never put private provider URLs in NEXT_PUBLIC_* variables.
XDC_RPC_URLS=https://rpc.xdcrpc.com,https://earpc.xinfin.network
XDC_RPC_TIMEOUT_MS=3500

# Optional server-side RPC fallbacks for verifying multichain forwarding recovery.
# Comma-separate multiple providers. Do not commit private provider URLs.
ETHEREUM_RPC_URLS=
BASE_RPC_URLS=
POLYGON_RPC_URLS=
ARBITRUM_RPC_URLS=
PAYMENT_RPC_TIMEOUT_MS=3500
XDC_API_CACHE_TTL_MS=15000

# Server-only key injected by the XDC AI Gateway. Never use NEXT_PUBLIC_*.
XDCID_GATEWAY_API_KEY=

# Server-only XDCScan settings used to discover historical registrations.
# Keep the API key in Vercel environment variables, never in source control.
XDCSCAN_API_KEY=
XDCSCAN_API_URL=https://api.etherscan.io/v2/api
XDCID_REGISTRAR_HISTORY=

# Server-only CoinGecko Demo API key for informational XDC pricing quotes.
# Add the real value in Vercel and never expose it through NEXT_PUBLIC_*.
COINGECKO_DEMO_API_KEY=
COINGECKO_PRICE_CACHE_MS=60000
COINGECKO_TIMEOUT_MS=3500

# Server-only signed registrar quote settings. Never use NEXT_PUBLIC_* for these.
# The signer must match the active signer in XNSPricingPolicy.
XNS_SIGNED_QUOTE_REGISTRAR=
XNS_PRICING_POLICY=
# Standalone V2 Subdomain Registrar used by the server-signed public flow.
XNS_SUBDOMAIN_REGISTRAR=
# Use legacy for the current mainnet signed registrar and v2 for Registrar V2.
XNS_PRICING_POLICY_VERSION=legacy
XNS_QUOTE_CHAIN_ID=50
XNS_QUOTE_RPC_URLS=
XNS_QUOTE_RPC_TIMEOUT_MS=3500
XNS_QUOTE_SIGNER_PRIVATE_KEY=

PRIVATE_KEY=0x...
NEXT_PUBLIC_XNS_REGISTRY=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_XNS_REGISTRAR=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_XNS_RESOLVER=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_XNS_REVERSE_RESOLVER=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_XNS_PRICING_POLICY=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_XNS_SUBDOMAIN_REGISTRAR=0x0000000000000000000000000000000000000000

# Keep false until the mainnet pricing policy and signed registrar are verified,
# activated, and the server-side quote variables below match those contracts.
NEXT_PUBLIC_SIGNED_REGISTRAR_ENABLED=false
# Enable only after the standalone Subdomain Registrar and its shared V2 policy
# are deployed, verified, and the server-side quote endpoint passes a smoke test.
NEXT_PUBLIC_SUBDOMAIN_REGISTRATION_ENABLED=false

# Operator-only mainnet rollout inputs. Never expose PRIVATE_KEY to the browser.
REGISTRY_ADDRESS=
LEGACY_REGISTRY_ADDRESS=
PRICING_POLICY_ADDRESS=
NEW_SIGNED_REGISTRAR=
POLICY_OWNER=
QUOTE_SIGNER=
USDC_ADDRESS=
TREASURY_ADDRESS=

# Server-only Neon PostgreSQL connection injected by the Vercel integration.
# It contains credentials and must never use a NEXT_PUBLIC_* variable.
DATABASE_URL=

# Server-only recipient for verified archive-subscription USDC payments.
# Configure separately for Preview and Production. This address is public on-chain,
# but keeping it server-side prevents stale client builds from selecting recipients.
ARCHIVE_SUBSCRIPTION_TREASURY_ADDRESS=

# Server-only keys for encrypted, wallet-gated payment receipts.
# Generate independent random values in Vercel; never commit their values.
PAYMENT_RECORD_ENCRYPTION_KEY=
# Stable HMAC secret for wallet-history lookup fingerprints. When introducing this
# to an existing deployment, first set it to the exact current encryption-key value.
# After that one-time compatibility step, encryption keys can rotate independently.
PAYMENT_PARTICIPANT_FINGERPRINT_KEY=
CRON_SECRET=
