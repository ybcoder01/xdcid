{
  "name": "@xdcid/sdk",
  "version": "0.2.0",
  "description": "XDCID resolution, quote, Pay Link, and transaction-preparation SDK",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./cctp": {
      "types": "./dist/cctp.d.ts",
      "import": "./dist/cctp.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "viem": ">=2.55.1 <3"
  }
}
